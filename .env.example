# Groq API (get your key at https://console.groq.com/keys)
GROQ_API_KEY=your-api-key-here

# LLM (available models at https://console.groq.com/docs/models)
LLM_MODEL=groq/compound

SERVER_WS_PORT=8765

# Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Playback: "device" = ESP32 speaker (default), "laptop" = edge-tts on this machine
PLAYBACK_TARGET=device
TTS_SERVER_VOICE=en-US-AriaNeural
TTS_SERVER_RATE=+0%

# Logs: set to DEBUG for verbose stage details (default INFO, compact flow)
#LOG_LEVEL=INFO