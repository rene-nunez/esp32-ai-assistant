# Copy this file to .env, edit the default options

# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=your-api-key-here

# Choose the LLM to use. See available models at https://console.groq.com/docs/models
LLM_MODEL=groq/compound

# Choose the language to use: en (English) or es (Spanish)
LANGUAGE=en

# Optional TTS settings. The default voice and rate are based on LANGUAGE
TTS_SERVER_VOICE=en-US-AriaNeural
TTS_SERVER_RATE=+0%

# Choose where to play the LLM response: computer (edge-tts on your computer) or esp32 (ESP32 speaker + amp)
PLAYBACK_TARGET=computer

# Choose the Whisper model: tiny (fastest), base, small, medium, or large-v3 (most accurate)
WHISPER_MODEL=base

# Choose where to run Whisper: cpu (processor), cuda (NVIDIA GPU), or auto (automatic selection)
WHISPER_DEVICE=cpu

# Choose the computation type: int8 (recommended for CPU), float16 (NVIDIA GPU), or float32 (highest precision)
WHISPER_COMPUTE_TYPE=int8

# WebSocket port used for communication
SERVER_WS_PORT=8765
